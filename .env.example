# Local LLM (OpenAI-compatible). Use 127.0.0.1, not localhost, on Windows.
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5-coder:3b
LLM_TIMEOUT_S=300

# Agent guardrails
MAX_ITERATIONS=6
# Comma-separated tool allowlist. Empty = allow every tool the MCP server exposes.
TOOL_ALLOWLIST=calculator,knowledge_search,current_datetime
